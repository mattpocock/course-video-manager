{
  // `.sandcastle/` is deliberately absent: a dot directory never matched the
  // `**/*` glob this program used before the monorepo split, so its harness has
  // never been part of a typecheck. Adding it is a separate job.
  "include": ["tests/**/*", "vitest.config.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node"],
    "target": "ESNext",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
