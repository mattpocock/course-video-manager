# Database Configuration
# The pooled connection string — every application query runs through it. On
# PlanetScale this is the PgBouncer endpoint; on a local container it is just
# the database.
#
# PlanetScale shows ONE string per role and no pooled variant to hunt for: the
# pooler is the same credentials on a different PORT, running on the primary's
# own node, already on. 6432 is PgBouncer; 5432 is Postgres itself. So the two
# below differ by their port — and, if you split the roles, by which one they
# authenticate as.
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai-app-template"
# Optional. The direct-to-primary connection string, used only by migrations
# (drizzle-kit and db:baseline). A transaction-mode pooler cannot carry
# session-level DDL state, so migrations must bypass it. Unset locally, where
# there is no pooler — migrations then fall back to DATABASE_URL.
# DIRECT_DATABASE_URL="postgresql://user:password@host.psdb.cloud:5432/db"
# Optional. Print every SQL statement the app sends, one "[cvm-sql]" line each,
# to stdout. The verify-cvm skill sets it on its verification servers and reads
# the lines back for its Write Ledger. Leave unset day to day.
# CVM_LOG_SQL=1

# The cvm CLI
# cvm reaches the domain data over HTTP, through the deployed API in
# apps/remote — the author's own invocations and an agent's alike, so the path
# an agent depends on is the path exercised every day. Neither of these is a
# database credential: a compromised box hands over a revocable token, not full
# Postgres access.
#
# On a remote box these are set as real environment variables and there is no
# .env at all. Mint the token from the "API Tokens" page in the local UI — it
# is shown once, at mint time.
CVM_API_URL="https://your-cvm-api.vercel.app"
CVM_API_TOKEN="cvm_xxxxxxxx_your_minted_token_here"
# Declares THIS machine as the author's — the one with the Storage Roots, the
# Video Files directory and ffmpeg on it. `cvm file`,
# `cvm course readiness` and `cvm course publish` need those and refuse to run
# anywhere else (exit 7), naming the reason so an agent stops rather than
# retries an ENOENT. It is declared rather than detected because every signal
# that could be detected is wrong in the dangerous direction; a box that says
# nothing is treated as remote, which is the safe default. NEVER set this on a
# remote box.
CVM_LOCAL_MACHINE="true"

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional, tests and verification only. Swap the Article Writer's model for a
# scripted fake that fails on demand: a "[fake:<scenario>]" directive in a chat
# message picks the failure (see apps/local/app/services/fake-writer-model.ts).
# Never set it day to day.
# CVM_FAKE_WRITER_MODEL=1

# Buffer (posting Shorts)
# A personal API key from publish.buffer.com/settings/api. Personal keys
# expire; when one does, posting fails at once with "Buffer API key invalid or
# expired" — mint a new one, set it here, restart.
BUFFER_API_TOKEN="your_buffer_api_key_here"
BUFFER_CHANNEL_ID="your_buffer_channel_id_here"
# Every service base-URL override below (and AI_HERO_BASE_URL,
# ANTHROPIC_BASE_URL, DROPBOX_API_URL, DROPBOX_CONTENT_URL)
# must be the service's own https host or loopback: anything else stops the
# app and the sidecar at startup, because the real token would go there
# (apps/local/app/services/service-url-guard.ts).
# Optional, tests and verification only. Point the Buffer client at a fake
# endpoint instead of https://api.buffer.com. Never set it day to day.
# BUFFER_API_URL=http://127.0.0.1:4010

# Optional, tests and verification only. Point every YouTube Data API call
# (uploads, thumbnails, the post-check) at a local stub instead of
# https://www.googleapis.com. Never set it day to day.
# YOUTUBE_API_URL=http://127.0.0.1:4010

# Optional, tests and verification only. Google's OAuth token endpoint, for
# refreshing the YouTube token, instead of https://oauth2.googleapis.com/token.
# GOOGLE_OAUTH_TOKEN_URL=http://127.0.0.1:4010/token

# Optional, tests and verification only. Send S3 uploads (a Buffer post's
# video) to a local, path-style stand-in instead of AWS.
# S3_ENDPOINT=http://127.0.0.1:4010

# Storage Roots (ADR 0040)
# Every drive CVM's files may be on, in lookup order, comma-separated. Every
# root has the same fixed folders: raw-footage/, finished-videos/ (Exported
# Videos), clip-mockups/ (Clip Mockup frames and speech, by lineageId) and
# overlay-renders/ (the Overlay Render Cache — safe to delete, re-rendered on
# demand). The database stores paths RELATIVE to a root; a file is read from
# the first root that has it, and new files are written to the first root.
# Moving a file between roots changes no row and no Export Hash.
# Replaces FINISHED_VIDEOS_DIRECTORY, CLIP_MOCKUP_DIR and
# OVERLAY_RENDER_CACHE_DIRECTORY: those folders are now <first root>/<folder>.
STORAGE_ROOTS="/mnt/d,/mnt/e"

# Dropbox API (publish transport)
# Create a scoped app at https://www.dropbox.com/developers/apps with
# full-Dropbox access. The remote path is the Courses folder within the account.
DROPBOX_APP_KEY="your_dropbox_app_key_here"
DROPBOX_APP_SECRET="your_dropbox_app_secret_here"
DROPBOX_REMOTE_PATH="/Courses"
# How many Videos stream to Dropbox at once during a Publish, and the
# upload-session chunk size (a multiple of 4 MB, at most 148). A Publish's
# resident memory ceiling is roughly the two multiplied together: 512 MB.
# DROPBOX_UPLOAD_CONCURRENCY="8"
# DROPBOX_UPLOAD_CHUNK_SIZE_MB="64"

# Video Files (and the Thumbnail PNGs among them) live in video-files/ under
# STORAGE_ROOTS (above), keyed by lineageId: video-files/{lineageId}/{file}.
# CVM-recorder Recording Sessions go in raw-footage/ on the first root.
# VIDEO_FILES_DIR is legacy and optional: where Video Files were before they
# had a Storage Root (default: this checkout's video-files/ folders). They are
# still read from there, never written, until `pnpm storage:relocate` moves
# them (#2105).
# VIDEO_FILES_DIR="/path/to/old/video-files"

# Clip Mockups live in clip-mockups/ under STORAGE_ROOTS (above), keyed by
# lineageId — deliberately NOT under video-files/: a Video File is Article
# Writer context, and sixty frames would drown the writer's context picker.

# Clip Mockup speech needs NO variables.
# `cvm clip-mockup add` and `update --say` voice the line with Kokoro-82M, in
# one voice (af_heart), loaded into the `cvm` process on this machine's GPU —
# no API key, no credentials, no quota. The model downloads once into
# ~/.cache/cvm/kokoro. The GPU path needs the CUDA 12 runtime libraries
# installed once (the exact command is CUDA_INSTALL_COMMAND in
# apps/local/app/services/clip-mockup-speech-kokoro.ts, and a failed load
# prints it). Without them those two verbs fail with _tag
# "SpeechSynthesisError" (exit 4); every other clip-mockup verb is unaffected.

# Diagram Thumbnails
# Directory where PNG thumbnails of preserved diagram snapshots are stored.
# Files are organized as: {DIAGRAM_THUMBNAILS_DIR}/{diagramId}/{contentHash}.png
DIAGRAM_THUMBNAILS_DIR="/path/to/diagram-thumbnails"

# tldraw licence key (optional — leave empty for the default watermark)
# Read on the server and handed to every tldraw component in the browser via
# the root loader; a tldraw licence key is designed to be public. Unset or
# empty, tldraw shows its "Made with tldraw" watermark.
TLDRAW_LICENSE_KEY=""

# Google OAuth (for YouTube uploads)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# AWS S3 (vertical video upload for Buffer social posts)
# A public-read bucket in eu-west-2 with a 1-day lifecycle expiry rule on the
# `cvm/buffer-posts/` prefix. Buffer fetches the uploaded object via its plain
# public URL (no auth / presigning).
AWS_ACCESS_KEY_ID="your_aws_access_key_id_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key_here"
AWS_REGION="eu-west-2"
S3_BUCKET="your_s3_bucket_name_here"

# Background Removal (remove.bg)
# Get an API key at https://www.remove.bg/api (50 free images/month)
REMOVE_BG_API_KEY="your_remove_bg_api_key_here"

# Space Desk (virtual TikTok-shaped monitor)
# The "Space Desk" sidebar button wakes the display at the PC's fixed IP
# (SPACEDESK_HOST in apps/local/app/spacedesk-wake.ts). Only the port is
# configurable via env (defaults to 28252):
# SPACEDESK_PORT="28252"

# Live channels on the desk (optional — leave unset)
# Where the browser finds the Stream Deck forwarder hub. Read by
# apps/local/app/lib/live-channels.ts. Unset, the main checkout gets the real
# desk and every worktree a dead port (apps/local/live-desk/live-desk.ts), so a
# worktree's editor never hears Matt's Stream Deck presses. A value here
# overrides it; verify-cvm runs set the dead port explicitly.
# VITE_STREAM_DECK_HUB_URL="ws://localhost:5172"
# Where the app server finds the recorder service (ADR 0034), by the same rule:
# the main checkout gets ws://127.0.0.1:5177, every worktree the dead port.
# Read by apps/local/app/services/recorder-client/live.server.ts.
# RECORDER_SERVICE_URL="ws://127.0.0.1:5177"

# Background-jobs sidecar (optional — leave unset)
# Where apps/local/sidecar/ listens and writes each Job's log. Unset, the socket
# is <checkout>/.data/sidecar.sock and Job logs go to <checkout>/.data/logs/jobs/.
# verify-cvm runs set both to their own run.
# CVM_SIDECAR_SOCKET="/path/to/sidecar.sock"
# CVM_SIDECAR_LOG_DIR="/path/to/logs/jobs"

# Optional. The .env file the Sidecar loads before anything else; unset, the
# repo-root .env. Its own entry-point test sets it; nothing else needs to.
# CVM_SIDECAR_ENV_FILE="/path/to/.env"

# Transcription needs NO variables and no setup by hand.
# Clips, Footage and vertical Shorts are transcribed by Local Whisper
# (faster-whisper, large-v3-turbo) on this machine's GPU, inside the Sidecar.
# When the Sidecar starts it builds the pinned Python env
# (apps/local/sidecar/local-whisper/requirements.lock) and downloads the model,
# once, into ~/.cache/cvm/whisper, shared by every checkout and worktree. It
# needs python3 with venv (`sudo apt install python3-venv`) and a working
# `nvidia-smi`; without them transcription Jobs fail with an error naming the
# fix. See apps/local/sidecar/local-whisper-engine.ts.
# Optional: CTranslate2's compute type. float16 (default, ~2.2 GB of VRAM) or
# int8_float16 (~1.2 GB, about as fast).
# CVM_WHISPER_COMPUTE_TYPE=float16

# The recorder service (apps/local/recorder-service, ADR 0034) finds ffmpeg.exe
# 8.0.1 under the Windows user's WinGet packages by itself.
# Optional: a WSL path to the ffmpeg.exe it should run instead.
# FFMPEG_EXE="/mnt/c/path/to/ffmpeg.exe"

# The test suite's Postgres (ADR 0046). By default the tests start and reuse the
# `cvm-test-postgres` Docker container, so Docker Desktop must be running.
# Optional: the admin URL (database `postgres`) of another LOCAL server to use
# instead; only localhost and host.docker.internal are accepted.
# CVM_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
