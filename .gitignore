.DS_Store
node_modules
.claude/worktrees/

# React Router
.react-router/
build/

# Turborepo
.turbo/

# `.env` alone matched only that exact name, so `vercel pull` — which writes
# `apps/remote/.env.local` — put a Vercel OIDC token into a commit. Match every
# local variant everywhere instead: no env file but `.env.example` is committed.
.env
.env.local
.env.*.local
.pnpm-store/

# Plans backup file (stored in repo but not committed)
plans-backup.json

# Per-video operation logs
.data/

# Generated assets
assets/

# Local diagram thumbnail store (fallback path when DIAGRAM_THUMBNAILS_DIR is unset)
diagram-thumbnails/
video-files
# The Clip Mockup frame store (fallback path when CLIP_MOCKUP_DIR is unset).
# ROOT-ANCHORED: unanchored, it also swallowed
# apps/local/app/features/clip-mockups/, which is source. The fallback really
# lands in apps/local, because getClipMockupBaseDir() anchors to the nearest
# package.json above its own module (exactly as video-files.ts does), so both
# paths are named rather than matched loosely.
/clip-mockups/
/apps/local/clip-mockups/
.worktrees

# The cutover wizard's working directory: full database dumps and the .env it
# backed up before it wrote to it. Never commit either.
.cutover/
packages/core/dist/
.vercel
