{
  "name": "course-video-manager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "bin": {
    "cvm": "apps/local/app/cli/bin.mjs"
  },
  "scripts": {
    "build": "turbo run build --filter=!@cvm/overlay-renderer",
    "dev": "turbo run dev --filter=!@cvm/overlay-renderer",
    "start": "turbo run start --filter=!@cvm/overlay-renderer",
    "test": "turbo run test test:root --concurrency=1 --filter=!@cvm/overlay-renderer",
    "test:watch": "turbo run test:watch --filter=!@cvm/overlay-renderer",
    "typecheck": "turbo run typecheck typecheck:root --filter=!@cvm/overlay-renderer",
    "lint:boundaries": "turbo run lint:boundaries --filter=!@cvm/overlay-renderer",
    "test:root": "vitest run",
    "typecheck:root": "tsgo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:generate": "pnpm --filter @cvm/core run db:generate",
    "db:migrate": "pnpm --filter @cvm/core run db:migrate",
    "db:baseline": "pnpm --filter @cvm/local run db:baseline",
    "db:verify-features": "pnpm --filter @cvm/local run db:verify-features",
    "db:backfill-search-text": "pnpm --filter @cvm/local run db:backfill-search-text",
    "db:studio": "pnpm --filter @cvm/core run db:studio",
    "db:clone-local": "pnpm --filter @cvm/local run db:clone-local",
    "gen:lucide-icons": "pnpm --filter @cvm/local run gen:lucide-icons",
    "sandcastle": "tsx ./.sandcastle/main.ts",
    "check:file-tokens": "./scripts/check-file-tokens.sh",
    "check:no-dirname": "./scripts/check-no-dirname.sh"
  },
  "pnpm": {
    "overrides": {
      "@ai-sdk/anthropic": "3.0.58",
      "@ai-sdk/provider": "3.0.8",
      "@ai-sdk/provider-utils": "4.0.19",
      "@ai-sdk/react": "3.0.118",
      "ai": "6.0.116",
      "@types/hast": "3.0.4"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "better-sqlite3": "0.0.0"
      },
      "ignoreMissing": [
        "better-sqlite3"
      ]
    }
  },
  "lint-staged": {
    "*": "prettier --write"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.10.0",
    "@types/node": "^20",
    "@typescript/native-preview": "^7.0.0-dev.20260304.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3",
    "vitest": "^3"
  }
}
