{
  "name": "course-video-manager",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "bin": {
    "cvm": "apps/local/app/cli/bin.mjs"
  },
  "scripts": {
    "build": "turbo run build --filter=!@cvm/overlay-renderer",
    "dev": "./scripts/run-with-log.sh dev",
    "start": "./scripts/run-with-log.sh start",
    "test": "turbo run test test:root test:browser --concurrency=1 --filter=!@cvm/overlay-renderer",
    "test:ci:rest": "turbo run test test:root --concurrency=1 --filter=!@cvm/overlay-renderer --filter=!@cvm/local",
    "test:ci:browser": "turbo run test:browser --filter=@cvm/local",
    "test:ci:local": "turbo run build --filter=@cvm/local^... && pnpm --filter @cvm/local exec vitest run",
    "test:watch": "turbo run test:watch --filter=!@cvm/overlay-renderer",
    "typecheck": "turbo run typecheck typecheck:root --filter=!@cvm/overlay-renderer",
    "lint:boundaries": "turbo run lint:boundaries --filter=!@cvm/overlay-renderer",
    "lint": "oxlint --type-aware",
    "test:root": "vitest run",
    "recorder:scorecard": "pnpm --filter @cvm/local recorder:scorecard",
    "typecheck:root": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky && ./scripts/patch-tsc.sh",
    "db:generate": "pnpm --filter @cvm/core run db:generate",
    "db:migrate": "pnpm --filter @cvm/core run db:migrate",
    "db:baseline": "pnpm --filter @cvm/local run db:baseline",
    "db:verify-features": "pnpm --filter @cvm/local run db:verify-features",
    "db:backfill-search-text": "pnpm --filter @cvm/local run db:backfill-search-text",
    "storage:migrate-paths": "pnpm --filter @cvm/local run storage:migrate-paths",
    "storage:rename-exports": "pnpm --filter @cvm/local run storage:rename-exports",
    "storage:relocate": "pnpm --filter @cvm/local run storage:relocate",
    "db:studio": "pnpm --filter @cvm/core run db:studio",
    "db:clone-local": "pnpm --filter @cvm/local run db:clone-local",
    "db:verify-snapshot": "./scripts/verify-snapshot.sh",
    "setup:verify-db": "./scripts/setup-verify-db.sh",
    "gen:lucide-icons": "pnpm --filter @cvm/local run gen:lucide-icons",
    "sandcastle": "tsx ./.sandcastle/main.ts",
    "check:file-tokens": "./scripts/check-file-tokens.sh",
    "check:no-dirname": "./scripts/check-no-dirname.sh",
    "check:script-db-url": "./scripts/check-script-db-url.sh",
    "check:db-clients": "./scripts/check-db-clients.sh",
    "check:clip-inserts": "./scripts/check-clip-inserts.sh",
    "check:env-example": "./scripts/check-env-example.sh",
    "check:routes-folder": "./scripts/check-routes-folder.sh",
    "check:entity-links": "./scripts/check-entity-links.sh",
    "check:duration-format": "./scripts/check-duration-format.sh",
    "check:response-body": "./scripts/check-response-body.sh",
    "check:fs-writes": "./scripts/check-fs-writes.sh",
    "check:toast-import": "./scripts/check-toast-import.sh",
    "check:effect-guards": "node scripts/check-effect-guards.ts",
    "check:effect-tsc": "node scripts/check-effect-tsc.ts",
    "check:frontend-state": "node scripts/check-frontend-state.ts",
    "check:background-jobs": "node scripts/check-background-jobs.ts",
    "check:static": "node scripts/check-effect-tsc.ts && pnpm run typecheck && pnpm run lint && pnpm run lint:boundaries && ./scripts/check-file-tokens.sh --all && ./scripts/check-no-dirname.sh --all && ./scripts/check-script-db-url.sh --all && ./scripts/check-db-clients.sh --all && ./scripts/check-clip-inserts.sh --all && ./scripts/check-env-example.sh --all && ./scripts/check-routes-folder.sh --all && ./scripts/check-entity-links.sh --all && ./scripts/check-duration-format.sh --all && ./scripts/check-response-body.sh --all && ./scripts/check-fs-writes.sh --all && ./scripts/check-toast-import.sh --all && node scripts/check-effect-guards.ts --all && node scripts/check-frontend-state.ts --all && node scripts/check-background-jobs.ts --all",
    "check:client-build": "turbo run build --filter=@cvm/local^... && pnpm --filter @cvm/local exec react-router build",
    "check": "pnpm run check:static && pnpm run test && pnpm run check:client-build"
  },
  "pnpm": {
    "overrides": {
      "@ai-sdk/anthropic": "3.0.128",
      "@ai-sdk/provider": "3.0.18",
      "@ai-sdk/provider-utils": "4.0.57",
      "@ai-sdk/react": "3.0.304",
      "ai": "6.0.301",
      "@types/hast": "3.0.4"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "better-sqlite3": "0.0.0"
      },
      "ignoreMissing": [
        "better-sqlite3"
      ]
    },
    "packageExtensions": {
      "@remotion/bundler": {
        "dependencies": {
          "typescript": "5.8.2"
        }
      },
      "dependency-cruiser": {
        "dependencies": {
          "typescript": "5.9.3"
        }
      }
    }
  },
  "lint-staged": {
    "*": "prettier --write"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.10.0",
    "@effect/tsgo": "0.48.1",
    "@types/node": "^20",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "oxc-parser": "0.153.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "^3.4.2",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "7.0.2",
    "vitest": "^3",
    "zod": "^4.4.3"
  }
}
