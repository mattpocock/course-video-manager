{
  "name": "@cvm/core",
  "version": "1.0.0",
  "description": "The domain database: the Drizzle schema, the DrizzleService and every db-* operations service. No filesystem, no child_process, no git — so it can be deployed as well as run locally.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint:boundaries": "depcruise db lib features rpc services test-utils",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.3",
    "effect": "^3.17.1",
    "fractional-indexing": "^3.2.0",
    "pg": "^8.23.0",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@effect/vitest": "^0.27.0",
    "@tldraw/store": "5.5.2",
    "@tldraw/tlschema": "5.5.2",
    "@tldraw/validate": "5.5.2",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "dependency-cruiser": "^18.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "7.0.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3"
  }
}
