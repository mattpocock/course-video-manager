{
  "name": "@cvm/overlay-renderer",
  "version": "1.0.0",
  "description": "Standalone Remotion renderer for CVM overlays \u2014 the subtitle + CTA caption overlay and AI Hero Definition Cards. Renders a transparent overlay at any resolution locally via @remotion/renderer (Chromium). No AWS/Lambda.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "render-overlay": "./bin.mjs"
  },
  "exports": {
    ".": "./src/render.ts",
    "./preview": "./src/preview.tsx",
    "./props": "./src/props.ts"
  },
  "scripts": {
    "studio": "remotion studio remotion/index.ts",
    "render": "node bin.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cvm/lucide-icons": "workspace:*",
    "@remotion/bundler": "4.0.347",
    "@remotion/cli": "4.0.347",
    "@remotion/google-fonts": "4.0.347",
    "@remotion/renderer": "4.0.347",
    "@remotion/tailwind-v4": "4.0.347",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "4.0.347",
    "tailwindcss": "4.1.1",
    "zod": "^3.25.46"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.1.8",
    "tsx": "^4.19.2",
    "typescript": "5.8.2",
    "vitest": "^3.0.0"
  },
  "sideEffects": [
    "*.css"
  ]
}
